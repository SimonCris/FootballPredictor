# Root .env.example
# Questo file mostra le variabili d'ambiente usate nel monorepo.
# Copiare in apps/backend/.env (vedi anche apps/backend/.env.example) e valorizzare.

# --- Backend ---
PORT=3000
NODE_ENV=development

# Chiave gratuita ottenibile registrandosi su https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=CHANGE_ME_FOOTBALL_DATA_ORG_KEY
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# TheSportsDB: "3" e' la chiave pubblica di test gratuita (nessuna registrazione richiesta).
# Per uso piu' intensivo registrare una chiave Patreon su https://www.thesportsdb.com/
THESPORTSDB_API_KEY=3
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json

# TTL cache in secondi per ridurre le chiamate ai provider esterni
CACHE_TTL_MATCHDAY=900
CACHE_TTL_PREDICTIONS=900

# Timeout (ms) e numero di retry per le chiamate HTTP ai provider
HTTP_TIMEOUT_MS=8000
HTTP_MAX_RETRIES=2

# --- Frontend ---
# URL base dell'API backend usato dal frontend Angular in sviluppo
API_BASE_URL=http://localhost:3000/api
