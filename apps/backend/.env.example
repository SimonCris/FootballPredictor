# Copiare questo file in apps/backend/.env e valorizzare le chiavi.

PORT=3000
NODE_ENV=development

# Chiave gratuita: registrarsi su https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=CHANGE_ME_FOOTBALL_DATA_ORG_KEY
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# "3" e' la chiave pubblica di test di TheSportsDB, nessuna registrazione richiesta.
THESPORTSDB_API_KEY=3
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json

CACHE_TTL_MATCHDAY=900
CACHE_TTL_PREDICTIONS=900
# Classifica: cambia raramente, TTL più lungo per ridurre le chiamate ai provider.
CACHE_TTL_STANDINGS=3600
# Quote di mercato: TTL medio, i bookmaker aggiornano le quote di frequente
# ma il piano free di The Odds API ha una quota mensile limitata (500 richieste).
CACHE_TTL_ODDS=1800

HTTP_TIMEOUT_MS=8000
HTTP_MAX_RETRIES=2

# CHANGE_ME (opzionale ma consigliato): chiave gratuita di The Odds API
# (https://the-odds-api.com/) — piano free 500 richieste/mese, solo email,
# nessuna carta di credito richiesta. Usata per arricchire i pronostici con
# le quote reali dei bookmaker (mercato 1X2) come segnale aggiuntivo oltre
# al modello statistico. Se lasciata vuota/placeholder, il calcolo funziona
# comunque usando solo il modello statistico (nessun errore).
ODDS_API_KEY=CHANGE_ME_THE_ODDS_API_KEY
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Origine consentita per CORS (frontend Angular in dev)
CORS_ORIGIN=http://localhost:4200
